#pragma kernel CSMain

#define USE_BVH

// 基础资源绑定
RWStructuredBuffer<int> _HitResultBuffer;
int _Width;
int _Height;
float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;

// --- 实例数据结构 ---
struct GPUInstanceData
{
    float4x4 localToWorld;
    float4x4 worldToLocal;
};

struct GPUTriangle
{
    float4 A, B, C;
};

// 基础数据源
StructuredBuffer<GPUTriangle> _Triangles;
StructuredBuffer<GPUInstanceData> _Instances; // 每一帧更新的矩阵数组
int _InstanceCount;

#ifdef USE_BVH
struct BVHNode
{
    float4 bmin; // xyz: min, w: leftNode/start triangle offset (negative if leaf)
    float4 bmax; // xyz: max, w: rightNode index / triCount
};
StructuredBuffer<BVHNode> _BVHNodes;
#endif

// ==========================================
// 几何检测工具函数
// ==========================================

bool RayAABB(float3 ro, float3 rd, float3 bmin, float3 bmax, out float tMin)
{
    float3 invD = 1.0 / (rd + 1e-9);
    float3 t0 = (bmin - ro) * invD;
    float3 t1 = (bmax - ro) * invD;
    float3 tSmall = min(t0, t1);
    float3 tBig = max(t0, t1);
    tMin = max(max(tSmall.x, tSmall.y), tSmall.z);
    float tMax = min(min(tBig.x, tBig.y), tBig.z);
    return tMax >= max(tMin, 0.0);
}

bool RayTriangle_MT(float3 ro, float3 rd, float3 A, float3 B, float3 C, out float t)
{
    float3 E1 = B - A;
    float3 E2 = C - A;
    float3 P = cross(rd, E2);
    float det = dot(E1, P);
    if (abs(det) < 1e-6)
        return false;
    float invDet = 1.0 / det;
    float3 T = ro - A;
    float u = dot(T, P) * invDet;
    if (u < 0.0 || u > 1.0)
        return false;
    float3 Q = cross(T, E1);
    float v = dot(rd, Q) * invDet;
    if (v < 0 || (u + v) > 1.0)
        return false;
    t = dot(E2, Q) * invDet;
    return t > 0.0;
}

// ==========================================
// BVH 遍歷邏輯 (本地空間)
// ==========================================

#ifdef USE_BVH
// 注意：這裡傳入的 ro, rd 必須是已經變換到本地空間的射線
void Intersect_BVH_Local(float3 ro, float3 rd, inout float bestT, inout int bestTri)
{
    int stack[32];
    int stackPtr = 0;
    stack[stackPtr++] = 0;

    while (stackPtr > 0)
    {
        int nodeIdx = stack[--stackPtr];
        BVHNode node = _BVHNodes[nodeIdx];
        
        float tMin;
        // 早期剔除：如果當前盒子的最近距離已經大於目前已知的最優 T，跳過
        if (RayAABB(ro, rd, node.bmin.xyz, node.bmax.xyz, tMin) && tMin < bestT)
        {
            int leftVal = (int) node.bmin.w;
            int count = (int) node.bmax.w;

            if (leftVal < 0) // 葉子節點
            {
                int start = -(leftVal + 1);
                for (int i = start; i < start + count; i++)
                {
                    GPUTriangle tri = _Triangles[i];
                    float t;
                    if (RayTriangle_MT(ro, rd, tri.A.xyz, tri.B.xyz, tri.C.xyz, t))
                    {
                        if (t < bestT && t > 0.001)
                        {
                            bestT = t;
                            bestTri = i;
                        }
                    }
                }
            }
            else // 內部節點：壓入左右子節點索引
            {
                if (stackPtr < 31)
                {
                    stack[stackPtr++] = (int) node.bmax.w; // Right
                    stack[stackPtr++] = (int) node.bmin.w; // Left
                }
            }
        }
    }
}
#endif

// ==========================================
// SCENE TRAVERSAL (處理實例矩陣變換)
// ==========================================

void TraceScene(float3 roWorld, float3 rdWorld, out float tWorld, out int triIdx)
{
    tWorld = 1e30;
    triIdx = -1;

    // 邏輯核心：遍歷場景中所有實例
    for (int i = 0; i < _InstanceCount; i++)
    {
        GPUInstanceData inst = _Instances[i];

        // 1. 將世界空間射線轉換到該實例的本地空間
        // 起點變換 (Point)
        float3 roLocal = mul(inst.worldToLocal, float4(roWorld, 1.0)).xyz;
        // 方向變換 (Vector: 丟棄平移)
        float3 rdLocal = mul((float3x3) inst.worldToLocal, rdWorld);

        // 2. 在本地空間執行 BVH 遍歷
        // 注意：這裡的 bestT 是相對於 rdLocal 的長度。
        // 如果有非統一縮放，tWorld 需要額外處理，但對於單純尋找最先擊中的物體，此邏輯依然成立。
        Intersect_BVH_Local(roLocal, rdLocal, tWorld, triIdx);
    }
}

// ==========================================
// MAIN ENTRY
// ==========================================

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) _Width || id.y >= (uint) _Height)
        return;

    // 1. 生成射線
    float2 uv = (float2(id.xy) + 0.5) / float2(_Width, _Height);
    float3 ro = _CameraToWorld._m03_m13_m23;
    float2 ndc = uv * 2.0 - 1.0;
    float4 view = mul(_CameraInverseProjection, float4(ndc, 1.0, 1.0));
    view.xyz /= view.w;
    float3 rd = normalize(mul((float3x3) _CameraToWorld, view.xyz));

    // 2. 遍歷場景
    float bestT;
    int bestTri;
    TraceScene(ro, rd, bestT, bestTri);

    // 3. 輸出 (僅中心像素示例)
    if (id.x == (uint) _Width / 2 && id.y == (uint) _Height / 2)
    {
        _HitResultBuffer[0] = bestTri;
    }
}